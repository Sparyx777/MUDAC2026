# Covariance and correlation 
cov_cor_results <- FSA_CPI |>
  select(
    CPI,
    Visits,
    `Pounds Distributed`,
    `Individuals Served`
  ) |>
  pivot_longer(
    cols = -CPI,
    names_to = "Metric",
    values_to = "Activity"
  ) |>
  group_by(Metric) |>
  summarise(
    Covariance = cov(CPI, Activity, use = "complete.obs"),
    Correlation = cor(CPI, Activity, use = "complete.obs"),
    .groups = "drop"
  )

print(cov_cor_results)


FSA_CPI |>
  select(
    CPI,
    Visits,
    `Pounds Distributed`,
    `Individuals Served`
  ) |>
  pivot_longer(
    cols = -CPI,
    names_to = "Metric",
    values_to = "Activity"
  ) |>
  ggplot(aes(x = CPI, y = Activity)) +
  geom_point() +
  geom_smooth(
    method = "lm",
    se = FALSE,
    color = "red"
  ) +
  facet_wrap(~ Metric, scales = "free_y") +
  theme_minimal() +
  labs(
    title = "CPI and Minnesota Food Shelf Activity",
    x = "Consumer Price Index",
    y = "Monthly Food Shelf Activity"
  )

FSA_CPI <- FSA_CPI |>
  arrange(Date) |>
  mutate(
    CPI_Detrended = residuals(
      lm(CPI ~ Trend, data = FSA_CPI, na.action = na.exclude)
    ),
    
    Visits_Detrended = residuals(
      lm(Visits ~ Trend, data = FSA_CPI, na.action = na.exclude)
    ),
    
    Pounds_Detrended = residuals(
      lm(`Pounds Distributed` ~ Trend,
         data = FSA_CPI,
         na.action = na.exclude)
    ),
    
    Individuals_Detrended = residuals(
      lm(`Individuals Served` ~ Trend,
         data = FSA_CPI,
         na.action = na.exclude)
    )
  )

detrended_lags <- tibble(
  Lag = 0:12,
  
  Visits = sapply(0:12, function(k) {
    cor(
      FSA_CPI$Visits_Detrended,
      lag(FSA_CPI$CPI_Detrended, k),
      use = "complete.obs"
    )
  }),
  
  Pounds = sapply(0:12, function(k) {
    cor(
      FSA_CPI$Pounds_Detrended,
      lag(FSA_CPI$CPI_Detrended, k),
      use = "complete.obs"
    )
  }),
  
  Individuals = sapply(0:12, function(k) {
    cor(
      FSA_CPI$Individuals_Detrended,
      lag(FSA_CPI$CPI_Detrended, k),
      use = "complete.obs"
    )
  })
)

print(detrended_lags)

detrended_lags |>
  pivot_longer(
    cols = c(Visits, Pounds, Individuals),
    names_to = "Metric",
    values_to = "Correlation"
  ) |>
  ggplot(aes(
    x = Lag,
    y = Correlation,
    color = Metric
  )) +
  geom_line(linewidth = 1) +
  geom_point(size = 2) +
  geom_hline(
    yintercept = 0,
    linetype = "dashed"
  ) +
  scale_x_continuous(breaks = 0:12) +
  theme_minimal() +
  labs(
    title = "Delayed Relationship Between CPI and Food Shelf Activity",
    x = "CPI Lag (Months)",
    y = "Pearson Correlation (r)",
    color = "Food Shelf Metric"
  )
