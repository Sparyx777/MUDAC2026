library(tidyverse)
file_path <- read.csv("C:/Users/kbmar/OneDrive - University of Wisconsin - Platteville/CPIdata.csv",skip = 11, check.names = FALSE)
Food_shelf_activity <- read_csv("C:/Users/kbmar/Downloads/FoodShelfdata cleanerv2.csv")

#Making sure _Month and _Year match DateForSearch
fsa_cleaned <- Food_shelf_activity |> 
  mutate(`_Month`= month(DateForSearch),`_Year`= year(DateForSearch)) |> 
  arrange(`_Month`)

fsa_cleaned <- fsa_cleaned |>
  mutate(
    HouseholdsReg = if_else(
      `__ID` == (22677),
      0,
      as.numeric(HouseholdsReg)
    )
  )
fsa_cleaned <- fsa_cleaned |>
  mutate(
    HouseholdsReg = if_else(
      `__ID` == (33141),
      0,
      as.numeric(HouseholdsReg)
    )
  )
fsa_cleaned <- fsa_cleaned |> mutate(
  PoundsReg = if_else(
    PoundsReg <= 0,
    0,
    as.numeric(PoundsReg)
  )
)

#Clean the CPI Data
cpi_clean <- file_path |> 
  mutate(Year = as.numeric(Year)) |> 
  filter(Year >= 2022 & Year <= 2026) |> 
  pivot_longer(
    cols = c(Jan, Feb, Mar, Apr, May, Jun, Jul, Aug, Sep, Oct, Nov, Dec),
    names_to = "Month",
    values_to = "CPI"
  ) 
cpi_clean <- cpi_clean |>
  mutate(
    Month_num = match(Month, month.abb),   # Converts "Jan", "Feb" to 1, 2, etc
    Date = make_date(Year, Month_num, 1)   # Creates a Date object (e.g., 2022-01-01)
  ) 
cpi_clean <- cpi_clean |> 
  filter(
    cpi_clean$Date >= as.Date("2022-01-01"),
    cpi_clean$Date <= as.Date("2026-07-01")
  )
#Total reporting for Visits, Pounds Distributed, and Individuals served 
#for each month in minnesota 

food_monthly <- fsa_cleaned |>
  filter(
    DateForSearch >= as.Date("2022-01-01"),
    DateForSearch <= as.Date("2026-07-31")
  ) |>
  group_by(
    Date = floor_date(DateForSearch, "month")
  ) |>
  summarise(
    Visits = sum(HouseholdsReg, na.rm = TRUE),
    "Pounds Distributed" = sum(PoundsReg, na.rm = TRUE),
    "Individuals Served" = sum(IndividualsReg, na.rm = TRUE),
    .groups = "drop"
  ) |>
  arrange(Date)

fsa_cleaned <- fsa_cleaned |> 
  mutate(FoodBank = sub("\\*$", "", FoodBank))

FSA_CPI <- food_monthly |>
  inner_join(cpi_clean, by = "Date") |>
  arrange(Date) |> 
  mutate(Trend = row_number()) 

